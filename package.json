{
  "name": "gh-tree",
  "version": "0.0.1",
  "description": "Show a tree of files from a local Git repo or remote GitHub repo, with line counts and .gitignore support.",
  "type": "module",
  "bin": {
    "gh-tree": "bin/gh-tree.mjs"
  },
  "exports": {
    ".": {
      "import": "./src/index.mjs"
    }
  },
  "main": "src/index.mjs",
  "files": [
    "bin",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "node bin/gh-tree.mjs",
    "test": "node tests/smoke.test.mjs"
  },
  "dependencies": {
    "yargs": "^17.7.2",
    "ignore": "^5.3.1",
    "undici": "^6.19.8"
  },
  "devDependencies": {
    "test-anywhere": "github:link-foundation/test-anywhere",
    "use-m": "github:link-foundation/use-m"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/link-foundation/gh-tree.git"
  }
}

